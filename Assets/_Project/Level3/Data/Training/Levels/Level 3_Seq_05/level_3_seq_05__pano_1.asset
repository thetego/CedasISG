      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "Gaz bas\u0131n\xE7 seviyesi uygun mu?"
      options:
      - SORUN YOK
      - SORUN VAR---GAZ BASINC SEVIYESI DUSUK
      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "H\xFCcre etiketleri kontrol\xFC yap\u0131ld\u0131 m\u0131?"
      options:
      - "SORUN VAR---PLAKA ET\u0130KET\u0130 YOK"
      - SORUN VAR---FIDER ETIKETLERI YOK
      - SORUN YOK
      - SORUN VAR---UYARI VE IKAZ LEVHALARI YOK
      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "H\xFCcre \xFCst\xFCnde K\u0131smi De\u015Farj \xF6l\xE7\xFCm
        de\u011Feri nedir?"
      options:
      - SORUN YOK
      - 25-30 DB ARASINDA
      - 30 DB USTUNDE
      - 20-25 DB ARASINDA
      - 5-10 DB ARASINDA
      - 15-20 DB ARASINDA
      - 0-5 DB ARASINDA
      - 10-15 DB ARASINDA
      - "H\xDCCRE ENERJ\u0130S\u0130Z"
      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "H\xFCcrede K\u0131smi De\u015Farj nerede?"
      options:
      - SORUN YOK
      - GENEL HUCRE KAZANINDA
      - KABLO BASLIKLARININ GIRIS NOKTASINDA
      - KESICI TARAFINDA
      - UST BARA BAGLANTILARINDA
      - SORUN VAR---DIGER (ACIKLAMAYA GIRINIZ)
      - "H\xDCCRE ENERJ\u0130S\u0130Z"
      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "R\xF6leler aktif mi?"
