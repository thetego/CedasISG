      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "Gaz bas\u0131n\xE7 seviyesi uygun mu?"
      options:
      - SORUN YOK
      - SORUN VAR---GAZ BASINC SEVIYESI DUSUK
      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "H\xFCcre etiketleri kontrol\xFC yap\u0131ld\u0131 m\u0131?"
