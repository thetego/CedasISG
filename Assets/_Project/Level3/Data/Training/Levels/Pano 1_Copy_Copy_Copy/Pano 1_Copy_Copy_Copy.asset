      isRequired: 1
    - questionText: "H\xFCcre \xFCst\xFCnde K\u0131smi De\u015Farj \xF6l\xE7\xFCm
        de\u011Feri nedir?"
      options:
      - SORUN YOK
      - 25-30 DB ARASINDA
      - 30 DB USTUNDE
      - 20-25 DB ARASINDA
      - 5-10 DB ARASINDA
      - 15-20 DB ARASINDA
      - 0-5 DB ARASINDA
      - 10-15 DB ARASINDA
      - "H\xDCCRE ENERJ\u0130S\u0130Z"
      correctOptionIndices: 00000000
      isRequired: 1
    - questionText: "H\xFCcrede K\u0131smi De\u015Farj nerede?"
      options:
      - SORUN YOK
      - GENEL HUCRE KAZANINDA
      - KABLO BASLIKLARININ GIRIS NOKTASINDA
      - KESICI TARAFINDA
      - UST BARA BAGLANTILARINDA
