# demo | playfab
DATA_PROVIDER=demo
DEMO_PASSWORD=replace-demo-password
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4173
SESSION_SECRET=replace-with-at-least-32-random-characters
RUNTIME_SETTINGS_FILE=.data/runtime-settings.enc
AUDIT_LOG_FILE=.data/audit.ndjson
PRIVACY_REQUESTS_FILE=.data/privacy-requests.enc

# PlayFab account switch: update only these deployment secrets.
PLAYFAB_TITLE_ID=
PLAYFAB_DATA_URL=
PLAYFAB_SERVICE_TOKEN=
PLAYFAB_TIMEOUT_MS=15000

# Internal Data Connection gateway (never expose these to the browser).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4180
GATEWAY_SERVICE_TOKEN=replace-with-at-least-32-random-characters
GATEWAY_DATABASE_FILE=.data/gateway.sqlite
GATEWAY_SYNC_INTERVAL_MS=60000
GATEWAY_RETENTION_DAYS=365
GATEWAY_PAGE_SIZE=1000
AZURE_BLOB_CONTAINER_URL=
PLAYFAB_SECRET_KEY=
PLAYFAB_WHITELIST_READER_ID=whitelist_reader
PLAYFAB_WHITELIST_KEY=PlayerWhitelist
GATEWAY_USERS_JSON=[]
